# Copy file ini jadi .env.local lalu isi key aslimu di bawah ini.
# Jangan pernah commit file .env.local ke git atau kirim ke siapa pun.
ANTHROPIC_API_KEY=isi_key_kamu_di_sini

# Opsional: biar rekap yang udah dikonfirmasi klien otomatis terkirim ke Discord.
# Cara ambil: buka Server Settings > Integrations > Webhooks > New Webhook, copy URL-nya.
DISCORD_WEBHOOK_URL=isi_webhook_url_discord_kamu_di_sini